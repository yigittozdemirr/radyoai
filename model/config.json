{
  "title": "RadyoAI v2: riskli karar modeli",
  "version": "2.2.0",
  "description": "Oyuncunun bir sonraki sahnede riskli seçeneği (B) seçme olasılığı. Yalnızca RadyoAI eğitim oyunu içindir.",
  "input": {
    "name": "input",
    "dtype": "float32",
    "shape": [
      null,
      5
    ]
  },
  "output": {
    "name": "probabilities",
    "dtype": "float32",
    "shape": [
      null,
      2
    ],
    "positive_class_index": 1
  },
  "features": [
    {
      "name": "sahne_no",
      "description": "Açılan sahne",
      "unit": "2 veya 3",
      "min": 2,
      "max": 3
    },
    {
      "name": "seviye",
      "description": "Girişteki beyan: 0 Yeni başladım, 1 Biraz biliyorum, 2 Deneyimliyim",
      "unit": "kod",
      "min": 0,
      "max": 2
    },
    {
      "name": "onceki_riskli_karar",
      "description": "Önceki sahnelerde seçilen B sayısı",
      "unit": "adet",
      "min": 0,
      "max": 2
    },
    {
      "name": "onceki_ort_karar_suresi_sn",
      "description": "Önceki sahnelerde sahne açılışından seçime ortalama süre",
      "unit": "saniye",
      "min": 0,
      "max": null
    },
    {
      "name": "onceki_ort_okuma_suresi_sn",
      "description": "Önceki sahnelerde sonuç panelinde geçen ortalama süre",
      "unit": "saniye",
      "min": 0,
      "max": null
    }
  ],
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "sahne_no",
      "seviye",
      "onceki_riskli_karar",
      "onceki_ort_karar_suresi_sn",
      "onceki_ort_okuma_suresi_sn"
    ],
    "additionalProperties": false,
    "properties": {
      "sahne_no": {
        "type": "number",
        "minimum": 2,
        "maximum": 3
      },
      "seviye": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "onceki_riskli_karar": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "onceki_ort_karar_suresi_sn": {
        "type": "number",
        "minimum": 0
      },
      "onceki_ort_okuma_suresi_sn": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "classes": [
    "0",
    "1"
  ],
  "class_labels": {
    "0": "güvenli seçim (A)",
    "1": "riskli seçim (B)"
  },
  "decision_threshold": 0.5,
  "acceptance": {
    "metric": "roc_auc",
    "threshold": 0.7,
    "split": "30% stratified hold-out"
  },
  "metrics": {
    "roc_auc": 0.7233,
    "accuracy": 0.6279,
    "cogunluk_sinifi_accuracy": 0.5736,
    "gercek_roc_auc": 1.0,
    "test_satir": 129,
    "test_gercek_satir": 10
  },
  "onnx_sklearn_max_diff": 8.22e-08,
  "data": {
    "file": "data/oturumlar.csv",
    "sha256": "3d1d3dfa432a26adc92942236c06d8a225ad6e892ca710b4affd655f9637ad31",
    "rows_used": 430,
    "gercek_rows": 30,
    "sentetik_rows": 400
  },
  "seed": 13,
  "python_version": "3.12",
  "sklearn_version": "1.9.1",
  "skl2onnx_version": "1.20.0"
}
